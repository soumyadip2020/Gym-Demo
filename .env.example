# Database (PostgreSQL / Neon) — optional in dev (falls back to in-memory store)
DATABASE_URL=

# AI Generation (uses Lovable AI Gateway or Gemini API if configured; falls back to curated plans)
LOVABLE_API_KEY=
GEMINI_API_KEY=

# Razorpay Payments (optional; free trial works without keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gym Owner Admin Panel (6-digit secret code; configure in .env and Vercel Environment Variables)
GYM_ADMIN_ACCESS_CODE=
